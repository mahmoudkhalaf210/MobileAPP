  // ── Driver notification strategy ──────────────────────────────────────
  // NotificationMode:
  //   "NearestOnly" → notify only the nearest NearestDriverCount available
  //                   online drivers (bounding-box + min-heap, production default)
  //   "AllDrivers"  → notify every driver regardless of location
  //                   (useful during early rollout / low driver density)



  "OrderSettings": {
    "NotificationMode": "AllDrivers",
    "ScheduledDispatchLeadTimeMinutes": 10,
    "ScheduledCancelCutoffMinutes": 15,
    "ScheduledReminderMinutes": 60,
    "ScheduledStartingSoonMinutes": 10,
    "ScheduledConflictWindowMinutes": 60
    //  "NotificationMode": "NearestOnly",
    //  "NearestDriverCount": 10
  },

  // v2 — points awarded per completed order (OrderNotificationServiceV2Decorator)
  "PointsSettings": {
    "PointsPerCompletedOrder": 10
  }

}
